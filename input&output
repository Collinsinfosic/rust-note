use std::io::{self,Read};
use crossterm::terminal::enable_raw_mode;
use crossterm::terminal::disable_raw_mode;

fn main(){
    enable_raw_mode().unwrap();
// 进入原始模式
// 原始模式下，按键输入会立即传递给程序，不需要按 Enter，输入也不会自动显示在终端。
// unwrap() 假设切换成功，失败则程序崩溃。
// 标准模式，用户输入只有再回车后，输入内容才会回显，正常情况下，终端是“行缓冲”模式，输入需要按 Enter 才会发送给程序。

    for b in io::stdin().bytes(){
        let b = b.unwrap();
        let c = b as char;
        // is_control用来查看用户是否输入控制字符
        if c.is_control(){
            // 如果是控制字符（回车等），执行此代码，否则进入else
            println!("Binary: {0:08b} ASCII: {0:#03} \r", b);
            // {0:08b} 0表示使用第 0 个参数（就是b） ，：标识分隔符，0是填充字符，8标识长度，b标识二进制
            // {0:#03} 0表示使用第 0 个参数（就是b）, ：标识分隔符，#标识十六进制，八进制的前缀，比如0X，0标识填充字符，3标识有3位
            // 这里没有用0X特殊的指定，所以用十进制的方式输出
            // println!("Binary: {0:08b} ASCII: {0:#04} \r", b);


        }else{
            println!("Binary: {0:08b} ASCII: {0:#03} Character: {1:#?}\r", b, c);
        // {1:#?} 1标识第一个参数（就是c，因为从0开始计算），:：分隔符，后面是格式化规则，#用来美化格式，？用来Debug模式输出



        }

        if c =='q'{
            disable_raw_mode().unwrap();
            break;
        }
    }
}

// unwrap() 是 Option 和 Result 提供的一个便捷方法：
// 对于 Option<T>：
// 如果是 Some(value)，返回 value。
// 如果是 None，程序崩溃（调用 panic!）。
// 对于 Result<T, E>：
// 如果是 Ok(value)，返回 value。
// 如果是 Err(_)，程序崩溃（调用 panic!）。
// 简单来说，unwrap() 假设值一定存在，直接“拆包”拿出来，如果假设错误（没值或有错误），程序就报错退出。
// 这里的 b 是 io::stdin().bytes() 返回的迭代器中的元素，类型是 Result<u8, std::io::Error>。
// b.unwrap() 的作用：
// 如果 b 是 Ok(byte)，返回 byte（一个 u8 值）。
// 如果 b 是 Err(error)（比如输入流出错），程序会崩溃，抛出类似“thread 'main' panicked”的错误。

