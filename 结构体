#[derive(Debug)]

struct Rectangle<'a>{
    width:u32,
    height:u32,
    name:&'a str,
}
// 结构体声明了生命周期，作为结构体的实现，同样也要声明生命周期
// 实现中生命周期后，对应的printname就不用声明生命周期了

impl<'a> Rectangle<'a> {
    // &self 是方法的参数，表示“借用调用这个方法的 Rectangle 实例”。
    fn area(&self)->u32{
        self.width *self.height
    }
// 为什么rect是width的所有者，还需要用&self来接用
// rust的机制是作用域结束后内存会被释放，所以如果传入rect，在area结束后，rect会
// 被释放掉，printname就无法再使用rect，所以即使是所有者，在这里也需要借用，这样printname才能继续使用rect中的值
    fn printname(&self)->&'a str{
        self.name
    }
    // 长宽的计算，名称的打印在栈中就可以完成
}

fn main(){
    let rect = Rectangle{
        width:3,
        height:5,
        name:"ceral",
    };

    println!(
        "The area of the rectangle is {} square pixels.",rect.area());
    println!("the area of name is : {}",rect.printname());
}
